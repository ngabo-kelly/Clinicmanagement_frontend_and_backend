    {
      "name": "B3 Reschedule",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/appointments/3/reschedule?newDate=2026-11-10"
      }
    },
    {
      "name": "C1 Write prescription",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"medicineName\": \"Amoxicillin\",\n  \"dosage\": \"1 tablet, 3 times a day\",\n  \"durationDays\": 7\n}"
        },
        "url": "{{baseUrl}}/api/prescriptions/save?appointmentId=5"

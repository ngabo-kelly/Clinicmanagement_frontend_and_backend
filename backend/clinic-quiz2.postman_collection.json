      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"medicineName\": \"Amoxicillin\",\n  \"dosage\": \"1 tablet, twice a day\",\n  \"durationDays\": 5\n}"
        },
        "url": "{{baseUrl}}/api/prescriptions/update/REPLACE-UUID"

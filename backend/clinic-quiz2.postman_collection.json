{
  "info": {
    "name": "Clinic Quiz 2",
    "description": "Quiz 2 Completing the Backend - one request per requirement ID",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:1014" }],
  "item": [
    {
      "name": "A1 Add specialization",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/api/doctors/2/specializations/1"
      }
    },
    {
      "name": "A2 Remove specialization",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/doctors/2/specializations/1"
      }
    },
    {
      "name": "A3 Free offices",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/offices/free"
      }
    },
    {
      "name": "A4 Move doctor office",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/doctors/1/office?officeNumber=104"
      }
    },
    {
      "name": "B1 Safe booking",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentDate\": \"2026-11-05\",\n  \"reason\": \"New visit\",\n  \"status\": \"COMPLETED\",\n  \"patient\": { \"id\": 1 },\n  \"doctor\": { \"id\": 2 }\n}"
        },
        "url": "{{baseUrl}}/api/appointments/save"
      }
